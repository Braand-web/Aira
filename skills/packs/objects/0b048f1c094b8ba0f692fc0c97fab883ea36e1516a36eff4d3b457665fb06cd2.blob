# -*- coding: utf-8 -*-
"""Moteur générique Reels Sira Vérités — MOTION DESIGN V2 (validé le 27/10/2026).
Usage : python3 build_reel_motion.py spec.json
Spec : {slug, voice (mp3), tail, segments: [{type, spoken, ...}], fin: {q1, q2, cta?}}
Les durées de scènes sont calculées au prorata des mots parlés de chaque segment.
Charte : FORMAT-MOTION-V2.md (même dossier).
"""
import glob, json, math, os, subprocess, sys
import numpy as np
from PIL import Image, ImageDraw, ImageFont, ImageFilter

BASE = os.path.dirname(os.path.abspath(__file__))
W, H, FPS = 1080, 1920, 30

INK   = (16, 16, 18); PAPER = (246, 241, 231); RED = (224, 49, 49)
GOLD  = (201, 162, 39); CREAM = (246, 241, 231)
COLORS = {"INK": INK, "PAPER": PAPER, "RED": RED, "GOLD": GOLD, "CREAM": CREAM}

def find_font(*names):
    for n in names:
        hits = sorted(glob.glob(f"/usr/share/fonts/truetype/noto/{n}"))
        if hits: return hits[0]
    return "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf"
F_BLACK  = find_font("NotoSansDisplay-Black.ttf", "NotoSans-Black.ttf")
F_CBLACK = find_font("NotoSansDisplay-CondensedBlack.ttf", "NotoSans-CondensedBlack.ttf")
F_XBOLD  = find_font("NotoSansDisplay-ExtraBold.ttf", "NotoSans-ExtraBold.ttf")
F_SEMI   = find_font("NotoSans-SemiBold.ttf", "NotoSansDisplay-SemiBold.ttf")
FONTS = {"BLACK": F_BLACK, "CBLACK": F_CBLACK, "XBOLD": F_XBOLD, "SEMI": F_SEMI}
_cache = {}
def font(path, size):
    key = (path, int(size))
    if key not in _cache: _cache[key] = ImageFont.truetype(path, int(size))
    return _cache[key]
def clamp(x, a=0.0, b=1.0): return max(a, min(b, x))
def ease_out(x): x = clamp(x); return 1 - (1 - x) ** 3
def ease_back(x):
    x = clamp(x); c = 1.70158
    return 1 + (c + 1) * (x - 1) ** 3 + c * (x - 1) ** 2
def lerp(a, b, p): return a + (b - a) * p
_probe = ImageDraw.Draw(Image.new("RGB", (10, 10)))
def fit(path, text, maxw, size):
    s = size
    while s > 12 and _probe.textlength(text, font=font(path, s)) > maxw: s -= 4
    return s
def spaced(draw, xy, text, fnt, fill, spacing=6):
    x, y = xy
    for ch in text:
        draw.text((x, y), ch, font=fnt, fill=fill)
        x += draw.textlength(ch, font=fnt) + spacing
    return x
def stamp(img, cx, cy, text, color, angle=-7, wbox=560, hbox=150, fsize=64):
    st = Image.new("RGBA", (wbox, hbox), (0, 0, 0, 0))
    sd = ImageDraw.Draw(st)
    sd.rounded_rectangle([6, 6, wbox - 6, hbox - 6], 14, outline=color, width=6)
    f = font(F_CBLACK, fsize); tw = sd.textlength(text, font=f)
    sd.text(((wbox - tw) / 2, hbox / 2 - fsize * 0.62), text, font=f, fill=color)
    st = st.rotate(angle, expand=True, resample=Image.BICUBIC)
    img.paste(st, (cx - st.width // 2, cy - st.height // 2), st)

rng = np.random.default_rng(11)
_noise_big = (rng.random((H * 2, W * 2)) * 255).astype(np.uint8)
noise_img = Image.fromarray(_noise_big, "L").convert("RGB")
def add_grain(img, t):
    ox = int((t * 137) % W); oy = int((t * 89) % H)
    crop = noise_img.crop((ox, oy, ox + W, oy + H))
    return Image.blend(img, Image.blend(img, crop, 0.5), 0.06)

# ---------- emojis & stickers ----------
_EMOJI_FONT_PATH = "/usr/share/fonts/truetype/noto/NotoColorEmoji.ttf"
_emoji_cache = {}
def emoji_rgba(ch, px):
    key = (ch, px)
    if key in _emoji_cache: return _emoji_cache[key]
    f = ImageFont.truetype(_EMOJI_FONT_PATH, 109)
    layer = Image.new("RGBA", (160, 160), (0, 0, 0, 0))
    ImageDraw.Draw(layer).text((8, 4), ch, font=f, embedded_color=True)
    bbox = layer.getbbox()
    crop = layer.crop(bbox) if bbox else layer
    crop = crop.resize((px, max(1, int(px * crop.height / crop.width))), Image.LANCZOS)
    _emoji_cache[key] = crop
    return crop
def stickerify(img, border=9):
    a = img.split()[3]
    sil = a.filter(ImageFilter.MaxFilter(border * 2 + 1))
    pad = border + 16
    out = Image.new("RGBA", (img.width + pad * 2, img.height + pad * 2), (0, 0, 0, 0))
    sh = Image.new("RGBA", out.size, (0, 0, 0, 0))
    ImageDraw.Draw(sh).bitmap((pad + 5, pad + 9), sil, fill=(0, 0, 0, 110))
    out.alpha_composite(sh.filter(ImageFilter.GaussianBlur(6)))
    white = Image.new("RGBA", out.size, (0, 0, 0, 0))
    ImageDraw.Draw(white).bitmap((pad, pad), sil, fill=(255, 255, 255, 255))
    out.alpha_composite(white)
    out.alpha_composite(img, (pad, pad))
    return out
_STICKERS = {}
def st(ch, px):
    key = (ch, px)
    if key not in _STICKERS: _STICKERS[key] = stickerify(emoji_rgba(ch, px))
    return _STICKERS[key]
def paste_pulse(base, sticker, cx, cy, lt, at, pulse=0.05, wobble=0.0):
    if lt < at: return
    p = ease_back((lt - at) / 0.35)
    s = max(p, 0.05) * (1 + pulse * math.sin(lt * 5.0))
    w = max(int(sticker.width * s), 4); h = max(int(sticker.height * s), 4)
    im = sticker.resize((w, h), Image.LANCZOS)
    if wobble: im = im.rotate(wobble * math.sin(lt * 26.0), expand=True, resample=Image.BICUBIC)
    base.paste(im, (cx - im.width // 2, cy - im.height // 2), im)
def _make_sira_sticker():
    src = Image.open(os.path.join(BASE, "..", "personnages", "sira-profil.jpg")).convert("RGB")
    crop = src.crop((12, 425, 962, 1375)).resize((480, 480), Image.LANCZOS)
    big = Image.new("RGBA", (520, 520), (0, 0, 0, 0))
    bd = ImageDraw.Draw(big)
    bd.ellipse([8, 14, 516, 522], fill=(0, 0, 0, 90))
    bd.ellipse([0, 0, 508, 508], fill=(255, 255, 255, 255))
    mask = Image.new("L", (480, 480), 0)
    ImageDraw.Draw(mask).ellipse([0, 0, 480, 480], fill=255)
    big.paste(crop, (14, 14), mask)
    return big
_SIRA = [None]
def sira_sticker(px):
    if _SIRA[0] is None: _SIRA[0] = _make_sira_sticker()
    return _SIRA[0].resize((px, px), Image.LANCZOS)

# ---------- spec / timings ----------
SPEC = json.load(open(sys.argv[1], encoding="utf-8"))
SEGMENTS = SPEC["segments"]
VOICE = os.path.join(BASE, SPEC["voice"])
TAIL = SPEC.get("tail", 3.4)
def probe_dur(path):
    r = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration",
                        "-of", "default=noprint_wrappers=1:nokey=1", path],
                       capture_output=True, text=True, check=True)
    return float(r.stdout.strip())
VD = probe_dur(VOICE)
DUR = VD + TAIL
_words = [max(1, len(s["spoken"].split())) for s in SEGMENTS]
_total = sum(_words)
BOUNDS = [0.0]
for w_ in _words: BOUNDS.append(BOUNDS[-1] + VD * w_ / _total)
SEGLEN = [BOUNDS[i + 1] - BOUNDS[i] for i in range(len(SEGMENTS))]

def split_caption(text):
    words = text.split()
    if len(words) <= 13: return [text]
    n = 2 if len(words) <= 26 else 3
    chunks, cur = [], []
    for w_ in words:
        cur.append(w_)
        if len(cur) >= math.ceil(len(words) / n) and len(chunks) < n - 1:
            chunks.append(" ".join(cur)); cur = []
    if cur: chunks.append(" ".join(cur))
    return chunks
CAPTIONS = []  # (start, end, text, emoji_or_None)
for i, seg in enumerate(SEGMENTS):
    chunks = split_caption(seg["spoken"])
    a, b = BOUNDS[i], BOUNDS[i + 1]
    tot = sum(len(c.split()) for c in chunks); t0 = a
    for j, c in enumerate(chunks):
        t1 = t0 + (b - a) * len(c.split()) / tot
        CAPTIONS.append((t0, t1, c, seg.get("cap_emoji") if j == 0 else None))
        t0 = t1
if SPEC.get("fin", {}).get("cap_tail"):
    CAPTIONS.append((VD + 0.1, DUR, SPEC["fin"]["cap_tail"], None))

def draw_caption(img, t):
    for a, b, txt, emo in CAPTIONS:
        if a <= t < b:
            d = ImageDraw.Draw(img, "RGBA")
            extra = 86 if emo else 0
            f = font(F_SEMI, fit(F_SEMI, txt, 950 - extra, 48))
            tw = d.textlength(txt, font=f)
            total = tw + 52 + extra
            x0 = (W - total) / 2
            d.rounded_rectangle([x0, 1635, x0 + total, 1745], 22, fill=(10, 10, 12, 215), outline=GOLD, width=2)
            d.text((x0 + 26 + extra, 1665), txt, font=f, fill=CREAM)
            if emo:
                e = emoji_rgba(emo, 60)
                img.paste(e, (int(x0 + 16), 1660), e)
            return
def progress(img, t):
    ImageDraw.Draw(img).rectangle([0, 0, W * clamp(t / DUR), 10], fill=RED)
def brand(img, color):
    d = ImageDraw.Draw(img, "RGBA")
    spaced(d, (60, 84), "SIRA VÉRITÉS", font(F_CBLACK, 46), color, 5)
def pop_text(d, x, y, text, fpath, size, color, lt, at, maxw=W - 120):
    if lt < at: return
    p = ease_back((lt - at) / 0.42)
    s = fit(fpath, text, maxw, size * max(p, 0.05))
    d.text((x, y), text, font=font(fpath, s), fill=color)
def draw_lines(img, d, lines, lt, seglen):
    for ln in lines:
        pop_text(d, ln.get("x", 60), ln["y"], ln["t"], FONTS[ln.get("f", "BLACK")],
                 ln["s"], COLORS[ln["c"]], lt, ln.get("at", 0.1) * seglen)
def draw_stickers(img, stickers, lt, seglen):
    for s_ in stickers or []:
        paste_pulse(img, st(s_["e"], s_["size"]), s_["x"], s_["y"], lt,
                    s_.get("at", 0.2) * seglen, pulse=s_.get("pulse", 0.05), wobble=s_.get("wobble", 0.0))

# ---------- scènes ----------
def sc_hook(img, t, seg, sl):
    lt = t
    d = ImageDraw.Draw(img, "RGBA")
    d.polygon([(W - 300, 0), (W, 0), (W, 300)], fill=RED)
    draw_lines(img, d, seg["lines"], lt, sl)
    stm = seg.get("stamp")
    if stm and lt > stm.get("at", 0.6) * sl:
        stamp(img, stm.get("x", W // 2), stm.get("y", 320), stm["t"], RED, angle=-7,
              wbox=stm.get("w", 600), hbox=150, fsize=stm.get("fs", 68))
    if lt > 0.82 * sl:
        d.rectangle([60, 1520, 60 + (W - 240) * ease_out((lt - 0.82 * sl) / 0.5), 1542], fill=RED)
    draw_stickers(img, seg.get("stickers"), lt, sl)
    if seg.get("sira"):
        paste_pulse(img, sira_sticker(seg["sira"].get("size", 260)), seg["sira"].get("x", 880),
                    seg["sira"].get("y", 1330), lt, seg["sira"].get("at", 0.45) * sl, pulse=0.02)
def sc_ink_chips(img, t, seg, sl):
    lt = t
    d = ImageDraw.Draw(img, "RGBA")
    d.rectangle([0, 0, 14, H], fill=RED)
    draw_lines(img, d, seg["lines"], lt, sl)
    for i, chip in enumerate(seg.get("chips", [])):
        at = chip.get("at", 0.25 + i * 0.2) * sl
        if lt < at: continue
        p = ease_out((lt - at) / 0.5)
        x = int(lerp(1150, chip.get("x", 560), p)); y = chip["y"]
        d.rounded_rectangle([x, y, x + 460, y + 130], 20, fill=CREAM)
        f = font(F_CBLACK, fit(F_CBLACK, chip["t"], 400, 58))
        tw = d.textlength(chip["t"], font=f)
        d.text((x + (460 - tw) / 2, y + 36), chip["t"], font=f, fill=INK)
    draw_stickers(img, seg.get("stickers"), lt, sl)
def sc_twist(img, t, seg, sl):
    lt = t
    d = ImageDraw.Draw(img, "RGBA")
    draw_lines(img, d, seg["lines"], lt, sl)
    bn = seg["banner"]; at = bn.get("at", 0.55) * sl
    if lt > at:
        p = ease_out((lt - at) / 0.5)
        y0 = bn.get("y", 1010); hh = bn.get("h", 350)
        d.rectangle([0, y0, W * p, y0 + hh], fill=RED)
        if lt > at + 0.4:
            for j, line in enumerate(bn["lines"]):
                d.text((60, y0 + 55 + j * 140), line,
                       font=font(F_BLACK, fit(F_BLACK, line, W - 120, bn.get("fs", 118))), fill=CREAM)
    draw_stickers(img, seg.get("stickers"), lt, sl)
def sc_choc(img, t, seg, sl):
    lt = t
    d = ImageDraw.Draw(img, "RGBA")
    draw_lines(img, d, seg["lines"], lt, sl)
    draw_stickers(img, seg.get("stickers"), lt, sl)
def sc_regle(img, t, seg, sl):
    lt = t
    d = ImageDraw.Draw(img, "RGBA")
    if lt > 0.08 * sl:
        stamp(img, 300, 330, "LA RÈGLE", RED, angle=-6, wbox=520, hbox=150, fsize=68)
    for i, chip in enumerate(seg["chips"]):
        at = (0.18 + i * 0.24) * sl
        if lt < at: continue
        p = ease_out((lt - at) / 0.5)
        x = int(lerp(-1150, 70, p)); y = 540 + i * 320
        d.rounded_rectangle([x + 14, y + 14, x + 954, y + 264], 26, fill=(0, 0, 0))
        d.rounded_rectangle([x, y, x + 940, y + 250], 26, fill=CREAM)
        d.ellipse([x + 38, y + 50, x + 188, y + 200], fill=RED)
        nf = font(F_CBLACK, 76); nw = d.textlength(chip["n"], font=nf)
        d.text((x + 113 - nw / 2, y + 82), chip["n"], font=nf, fill=CREAM)
        lf = font(F_BLACK, fit(F_BLACK, chip["t"], 620, 74))
        d.text((x + 225, y + 88), chip["t"], font=lf, fill=INK)
        if p > 0.92:
            ck = st("✅", 84)
            img.paste(ck, (x + 838, y + 72), ck)
    if seg.get("note") and lt > 0.9 * sl:
        d.text((70, 1520), seg["note"], font=font(F_SEMI, 56), fill=INK)
    draw_stickers(img, seg.get("stickers"), lt, sl)
def sc_ink_text(img, t, seg, sl):
    lt = t
    d = ImageDraw.Draw(img, "RGBA")
    draw_lines(img, d, seg["lines"], lt, sl)
    if seg.get("goldbar") and lt > 0.85 * sl:
        d.rectangle([60, 1300, 60 + (W - 120) * ease_out((lt - 0.85 * sl) / 0.45), 1322], fill=GOLD)
    draw_stickers(img, seg.get("stickers"), lt, sl)
def sc_signature(img, t, seg, sl):
    lt = t
    d = ImageDraw.Draw(img, "RGBA")
    draw_lines(img, d, seg["lines"], lt, sl)
    if lt > 0.8 * sl:
        d.rectangle([60, 1330, 60 + (W - 240) * ease_out((lt - 0.8 * sl) / 0.45), 1352], fill=GOLD)
    draw_stickers(img, seg.get("stickers"), lt, sl)
    if seg.get("sira"):
        paste_pulse(img, sira_sticker(seg["sira"].get("size", 280)), seg["sira"].get("x", 875),
                    seg["sira"].get("y", 1335), lt, seg["sira"].get("at", 0.15) * sl, pulse=0.02)
def sc_fin(img, t, seg, sl):
    lt = t - VD
    fin = SPEC["fin"]
    d = ImageDraw.Draw(img, "RGBA")
    spaced(d, (60, 84), "SIRA VÉRITÉS — CHAQUE JOUR", font(F_CBLACK, 46), CREAM, 5)
    if lt > 0.2:
        p = ease_back((lt - 0.2) / 0.45)
        wbox, hbox = int(920 * max(p, 0.05)), int(430 * max(p, 0.05))
        x0, y0 = (W - wbox) // 2, 560
        d.rounded_rectangle([x0, y0, x0 + wbox, y0 + hbox], 28, fill=CREAM)
        if p > 0.8:
            qf = font(F_BLACK, 118); qw = d.textlength(fin["q1"], font=qf)
            d.text(((W - qw) / 2, y0 + 55), fin["q1"], font=qf, fill=INK)
            sf = font(F_XBOLD, fit(F_XBOLD, fin["q2"], wbox - 80, 72))
            sw = d.textlength(fin["q2"], font=sf)
            d.text(((W - sw) / 2, y0 + 225), fin["q2"], font=sf, fill=RED)
    paste_pulse(img, st("💬", 120), 918, 640, lt, 0.55, pulse=0.06)
    if lt > 1.1:
        gf = font(F_XBOLD, 62); gt = "RÉPONDS EN COMMENTAIRE"
        gw = d.textlength(gt, font=gf)
        d.text(((W - gw) / 2, 1130), gt, font=gf, fill=GOLD)
    if lt > 1.45:
        d.rounded_rectangle([164, 1229, 944, 1344], 55, fill=(0, 0, 0))
        d.rounded_rectangle([150, 1215, 930, 1330], 55, fill=CREAM)
        d.text((196, 1247), "PARTAGE À UN FRÈRE", font=font(F_CBLACK, 54), fill=INK)
        fe = emoji_rgba("🔁", 72)
        img.paste(fe, (822, 1237), fe)
    if fin.get("cta") and lt > 1.9:
        cf = font(F_SEMI, fit(F_SEMI, fin["cta"], W - 160, 50))
        cw = d.textlength(fin["cta"], font=cf)
        d.text(((W - cw) / 2, 1380), fin["cta"], font=cf, fill=GOLD)
    if lt > 2.2:
        stamp(img, W // 2, 1520, "SIRA VÉRITÉS", CREAM, angle=-7, wbox=560, hbox=150, fsize=64)
    paste_pulse(img, st("❤️", 100), 170, 1520, lt, 2.4, pulse=0.09)
    paste_pulse(img, st("🔥", 100), 910, 1520, lt, 2.6, pulse=0.09)
SCENES_FN = {"hook": sc_hook, "ink_chips": sc_ink_chips, "twist": sc_twist, "choc": sc_choc,
             "regle": sc_regle, "ink_text": sc_ink_text, "signature": sc_signature}
BG = {"hook": PAPER, "ink_chips": INK, "twist": PAPER, "choc": RED,
      "regle": PAPER, "ink_text": INK, "signature": PAPER, "fin": INK}
BRANDC = {"hook": INK, "ink_chips": CREAM, "twist": INK, "choc": CREAM,
          "regle": INK, "ink_text": CREAM, "signature": INK}

def render_frame(i):
    t = i / FPS
    img = None
    if t >= VD:
        img = Image.new("RGB", (W, H), INK)
        sc_fin(img, t, None, TAIL)
    else:
        for k, seg in enumerate(SEGMENTS):
            if BOUNDS[k] <= t < BOUNDS[k + 1]:
                img = Image.new("RGB", (W, H), BG[seg["type"]])
                SCENES_FN[seg["type"]](img, t - BOUNDS[k], seg, SEGLEN[k])
                brand(img, BRANDC[seg["type"]])
                break
    if img is None: img = Image.new("RGB", (W, H), INK)
    for cut in BOUNDS[1:] + [VD]:
        dt = t - cut
        if 0 <= dt < 0.18:
            from PIL import ImageChops
            img = ImageChops.offset(img, int(9 * (1 - dt / 0.18) * math.sin(dt * 95)), 0)
            if dt < 0.10:
                img = Image.blend(img, Image.new("RGB", (W, H), (255, 250, 240)), 0.16 * (1 - dt / 0.10))
            break
    img = add_grain(img, t)
    draw_caption(img, t)
    progress(img, t)
    return img

def synth_score(path):
    sr = 48000; n = int(sr * DUR)
    audio = np.zeros(n, dtype=np.float64)
    def add(start, sig):
        s = int(start * sr); e = min(n, s + len(sig))
        if e > s: audio[s:e] += sig[:e - s]
    beat = 60.0 / 124.0
    for k in range(int(DUR / beat)):
        tt = np.arange(int(0.22 * sr)) / sr
        add(k * beat, np.sin(2 * np.pi * (110 * np.exp(-tt * 9) + 38) * tt) * np.exp(-tt * 11) * 0.55)
        ht = np.arange(int(0.05 * sr)) / sr
        add(k * beat + beat / 2, (rng.random(len(ht)) * 2 - 1) * np.exp(-ht * 90) * 0.06)
        bt = np.arange(int(0.30 * sr)) / sr
        add(k * beat, np.sin(2 * np.pi * 55 * bt) * np.exp(-bt * 5) * 0.16)
    for cut in BOUNDS[1:] + [VD]:
        wt = np.arange(int(0.16 * sr)) / sr
        noise = np.convolve(rng.random(len(wt)) * 2 - 1, np.ones(24) / 24, mode="same") * np.sin(np.pi * wt / 0.16) * 0.22
        add(cut - 0.08, noise)
        it = np.arange(int(0.18 * sr)) / sr
        add(cut, np.sin(2 * np.pi * 70 * it) * np.exp(-it * 14) * 0.5)
        btt = np.arange(int(0.09 * sr)) / sr
        add(cut + 0.03, np.sin(2 * np.pi * (700 + 500 * btt / 0.09) * btt) * np.exp(-btt * 30) * 0.10)
    rt = np.arange(int(1.0 * sr)) / sr
    add(max(0.0, VD - 1.0), np.sin(2 * np.pi * (180 + 520 * rt) * rt) * rt * 0.05)
    audio = np.clip(audio, -0.9, 0.9)
    import wave
    with wave.open(path, "wb") as wf:
        wf.setnchannels(1); wf.setsampwidth(2); wf.setframerate(sr)
        wf.writeframes((audio * 32767).astype(np.int16).tobytes())

def main():
    slug = SPEC["slug"]
    frames = os.path.join(BASE, "work", f"frames-{slug}")
    os.makedirs(frames, exist_ok=True)
    nframes = int(FPS * DUR)
    print(f"voix={VD:.2f}s total={DUR:.2f}s frames={nframes}", flush=True)
    for i in range(nframes):
        render_frame(i).save(os.path.join(frames, f"f{i:04d}.jpg"), quality=88)
        if i % 200 == 0: print(f"frame {i}/{nframes}", flush=True)
    score = os.path.join(BASE, "work", f"score-{slug}.wav"); synth_score(score)
    out = os.path.join(BASE, f"{slug}.mp4")
    subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-framerate", str(FPS), "-i", os.path.join(frames, "f%04d.jpg"),
                    "-i", VOICE, "-i", score,
                    "-filter_complex", f"[1:a]volume=1.0,apad=whole_dur={DUR:.2f}[v];[2:a]volume=0.55[m];[v][m]amix=inputs=2:duration=first:dropout_transition=0,loudnorm=I=-14:TP=-1.5:LRA=11[a]",
                    "-map", "0:v", "-map", "[a]", "-c:v", "libx264", "-preset", "fast", "-crf", "18",
                    "-pix_fmt", "yuv420p", "-r", str(FPS), "-c:a", "aac", "-b:a", "192k", "-ar", "48000",
                    "-movflags", "+faststart", "-t", str(DUR), out], check=True)
    up = os.path.join(BASE, f"{slug}-upload.mp4")
    subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-i", out, "-vf", "hqdn3d=1.2:1.2:5:5",
                    "-c:v", "libx264", "-preset", "medium", "-crf", "23", "-pix_fmt", "yuv420p",
                    "-movflags", "+faststart", "-c:a", "copy", up], check=True)
    subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-ss", "1.2", "-i", out, "-frames:v", "1",
                    "-update", "1", os.path.join(BASE, f"{slug}-thumb.jpg")], check=True)
    print("DONE", out, up, flush=True)

if __name__ == "__main__":
    main()
