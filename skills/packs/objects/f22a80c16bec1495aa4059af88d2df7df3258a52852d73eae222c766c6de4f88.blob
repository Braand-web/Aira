#!/usr/bin/env python3
"""Describe a .pptx: slide size, layouts, and per-slide titles, text, notes, media.

Usage: python pptx_dump.py deck.pptx [--notes]
"""
import sys

from pptx import Presentation
from pptx.util import Emu


def main():
    if len(sys.argv) < 2:
        sys.exit(__doc__)
    prs = Presentation(sys.argv[1])
    show_notes = "--notes" in sys.argv
    print(f"size: {Emu(prs.slide_width).inches:.2f} x {Emu(prs.slide_height).inches:.2f} in, slides: {len(prs.slides)}")
    print("layouts:", ", ".join(f"{i}:{l.name}" for i, l in enumerate(prs.slide_layouts)))
    for n, slide in enumerate(prs.slides, 1):
        title = slide.shapes.title.text.strip() if slide.shapes.title is not None else "(no title placeholder)"
        pics = sum(1 for s in slide.shapes if s.shape_type == 13)
        charts = sum(1 for s in slide.shapes if getattr(s, "has_chart", False) and s.has_chart)
        tables = sum(1 for s in slide.shapes if getattr(s, "has_table", False) and s.has_table)
        print(f"\n--- slide {n} [{slide.slide_layout.name}] {title}")
        print(f"    shapes={len(slide.shapes)} pictures={pics} charts={charts} tables={tables}")
        for shp in slide.shapes:
            if shp.has_text_frame and shp != slide.shapes.title:
                txt = " / ".join(p.text.strip() for p in shp.text_frame.paragraphs if p.text.strip())
                if txt:
                    print(f"    [{shp.name}] {txt[:160]}")
            right = (shp.left or 0) + (shp.width or 0)
            bottom = (shp.top or 0) + (shp.height or 0)
            if right > prs.slide_width or bottom > prs.slide_height:
                print(f"    !! '{shp.name}' extends beyond the slide")
        if show_notes and slide.has_notes_slide:
            note = slide.notes_slide.notes_text_frame.text.strip()
            if note:
                print(f"    notes: {note[:300]}")


if __name__ == "__main__":
    main()
