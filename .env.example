# Server configuration only. For the local adapter, copy required entries into .dev.vars.
# Never commit .dev.vars or paste a real API key in chat.
APP_ENV=test
# Independent Braand login. Set a canonical HTTPS origin and a random server secret.
# Login stays closed until a verified sender and Resend sandbox/live mode are ready.
APP_ORIGIN=
AUTH_ENABLED=false
AUTH_HASH_SECRET=
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_RATE_JSON=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_RATE_JSON=
# Internal task routing: legacy LLM_PROVIDER remains in use until this is enabled.
# Keys and validated per-model prices belong only in server secrets.
MODEL_ROUTING_ENABLED=false
# adaptive starts each user turn on light and lets the model request more capacity.
MODEL_ROUTING_POLICY=legacy
MODEL_ROUTING_CATALOG_JSON={}
OPENAI_API_KEY=
FAL_KEY=
FAL_CATALOG_JSON=[]
COMPOSIO_API_KEY=
# Custom auth configurations already created by the administrator in Composio.
# Meta Ads requires a custom auth configuration. Managed-auth apps need no entry.
COMPOSIO_AUTH_CONFIGS_JSON={}
# Paid Composio Instant tools are disabled unless explicitly enabled after pricing and budget review.
COMPOSIO_INSTANT_ENABLED=false
COMPOSIO_INSTANT_CATALOG_JSON=[]
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=
META_REDIRECT_URI=
TOKEN_ENCRYPTION_KEY=
FILE_PREVIEW_V1=false
# Use a dedicated random secret (at least 32 characters) for short-lived file URL signatures.
FILE_URL_SIGNING_SECRET=
SCHEDULER_SECRET=
OPS_ADMIN_IDS=
BILLING_ADMIN_IDS=
FREE_DAILY_CREDITS=0
BILLING_ENABLED=false
BILLING_XAF_CHECKOUT_VALIDATED=false
BILLING_TAX_VALIDATED=false
# Server-authored tax treatment (mode, rateBps, jurisdiction, version, validatedAt).
# Never infer tax liability from the operator's residence; unknown treatment blocks checkout.
BILLING_TAX_JSON=
BILLING_BENCHMARKS_VALIDATED=false
BILLING_SCHEDULER_VERIFIED=false
BILLING_PROVIDER_TESTS_PASSED=false
BILLING_SUPPORT_READY=false
BILLING_TERMS_APPROVED=false
BILLING_RESTORE_TESTED=false
BILLING_WEBHOOK_VERIFIED=false
BILLING_PRODUCT_ACCEPTANCE=false
BILLING_LEGAL_JSON=
BILLING_ECONOMICS_JSON={}
SASPAY_ENV=sandbox
SASPAY_SECRET_KEY=
SASPAY_MERCHANT_ID=
SASPAY_WEBHOOK_SECRET=
PAGES_ORIGIN=
PAGE_FORM_SECRET=
AUTONOMY_ENABLED=false
AUTONOMY_SCHEDULER_VERIFIED=false
BACKUP_ENABLED=false
BACKUP_ENCRYPTION_KEY=
BACKUP_MAINTENANCE_CONFIRMED=false
BACKUP_RESTORE_ALLOWED=false
RESEND_MODE=disabled
RESEND_API_KEY=
RESEND_FROM=
RESEND_TEST_RECIPIENT=
OPS_ALERT_EMAIL=
RESEND_LIVE_APPROVED=false
# Cloud browser: closed until trusted auth, actual staging, ownership and costs validated.
BROWSER_ENABLED=false
BROWSER_AUTH_VERIFIED=false
BROWSER_STAGING_VERIFIED=false
BROWSER_PRICING_VALIDATED=false
BROWSER_MARGIN_VERIFIED=false
BROWSER_OWNERSHIP_VERIFIED=false
BROWSER_PRICING_JSON=
BROWSER_PROFILE_KEY=
BROWSER_MAX_ACTIONS=40
BROWSER_MAX_SECONDS=1200
BROWSER_HUMAN_WAIT_SECONDS=300
