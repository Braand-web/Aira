# Server configuration only. For the local adapter, copy required entries into .dev.vars.
# Never commit .dev.vars or paste a real API key in chat.
COMPOSIO_API_KEY=
# Custom auth configurations already created by the administrator in Composio.
# Meta Ads requires a custom auth configuration. Managed-auth apps need no entry.
COMPOSIO_AUTH_CONFIGS_JSON={}
# Capability enabled, but no paid tool can run without a verified catalogue, subscription and approval.
COMPOSIO_INSTANT_ENABLED=true
COMPOSIO_INSTANT_CATALOG_JSON=[]
FILE_PREVIEW_V1=false
# Use a dedicated random secret (at least 32 characters) for short-lived file URL signatures.
FILE_URL_SIGNING_SECRET=
